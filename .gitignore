# ==============================================================================
# Settly Sovereign Real Estate Platform — Git Ignore Specification
# ==============================================================================

# ------------------------------------------------------------------------------
# Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
.pnpm-store/
jspm_packages/
web_modules/

# ------------------------------------------------------------------------------
# Production Builds & Bundler Outputs
# ------------------------------------------------------------------------------
dist/
build/
out/
.next/
.nuxt/
.astro/
.output/
.turbo/
.cache/
.parcel-cache/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
develop-eggs/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.manifest
*.spec
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# Environment Variables, Secrets & Credentials
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.env.*
*.pem
*.key
*.cert
*.crt
# Allow committed example envs
!*.env.example
!.env.example

# ------------------------------------------------------------------------------
# Logs & Diagnostic Dumps
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# Testing, Coverage & Playwright
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
cypress/videos/
cypress/screenshots/

# ------------------------------------------------------------------------------
# Temporary Artifacts & Screenshots
# ------------------------------------------------------------------------------
screenshot.png
screenshot_*.png
*.tmp
*.temp
.tempmediaStorage/

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# IDE & Code Editor Artifacts
# ------------------------------------------------------------------------------
.idea/
*.iws
*.iml
*.ipr
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.sublime-project

# VS Code (ignore local state, preserve shared configurations)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.vscode/*.log

# ------------------------------------------------------------------------------
# Prisma
# ------------------------------------------------------------------------------
# Generated Prisma client (regenerated on postinstall)
backend/src/generated/

# ------------------------------------------------------------------------------
# Docker
# ------------------------------------------------------------------------------
docker/data/
docker/volumes/
*.pid

# ------------------------------------------------------------------------------
# Agent & AI Tool State (local-only, not for repo)
# ------------------------------------------------------------------------------
.specify/
.claude/
graphify-out/
skills-lock.json
