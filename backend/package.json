{
  "name": "settly-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch src/settly-api.ts",
    "dev:worker": "tsx watch src/settly-worker.ts",
    "postinstall": "prisma generate",
    "build": "prisma generate && tsc",
    "start:api": "node dist/settly-api.js",
    "start:worker": "node dist/settly-worker.js",
    "lint": "eslint .",
    "test:boundaries": "node test/boundary-lint.test.mjs",
    "test:health": "node test/healthcheck.test.mjs",
    "test:db": "node test/database-constraints.test.mjs",
    "test:endpoints": "node test/endpoints/areas.test.mjs",
    "test:auth": "node test/endpoints/auth.test.mjs",
    "test:agent-verification": "node test/endpoints/agent-verification.test.mjs",
    "test:catalog": "node test/endpoints/catalog.test.mjs",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "check:openapi-drift": "tsx scripts/check-openapi-drift.ts",
    "test": "npm run test:boundaries && npm run test:health && npm run check:openapi-drift && npm run test:endpoints && npm run test:auth && npm run test:agent-verification && npm run test:catalog"
  },
  "dependencies": {
    "@prisma/client": "^6.4.0",
    "better-auth": "^1.1.21",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "resend": "^6.28.0",
    "uuidv7": "^1.0.2",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@eslint/js": "^9.17.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "eslint": "^9.17.0",
    "eslint-plugin-import": "^2.31.0",
    "prisma": "^6.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
