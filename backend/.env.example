# ==============================================================================
# Settly Backend Environment Configuration (Example)
# See docs/process/ENVIRONMENT.md for full specification
# ==============================================================================

# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL with PostGIS, pgvector, pg_trgm, btree_gist)
DATABASE_URL=postgresql://settly:settly@localhost:5432/settly

# Redis (Local Docker Redis or Upstash Redis TCP URL)
REDIS_URL=redis://localhost:6379

# Better Auth
BETTER_AUTH_SECRET=changeme_minimum_32_characters_random_string
BETTER_AUTH_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Transactional Email (Resend - Decision #44, Mailpit eliminated)
RESEND_API_KEY=re_placeholder_key
EMAIL_FROM=Settly <notifications@settly.estate>

# Gemini AI (Embeddings and RAG tools)
GEMINI_API_KEY=placeholder_gemini_api_key

# Cloudinary (Public property media)
CLOUDINARY_CLOUD_NAME=settly-dev
CLOUDINARY_API_KEY=placeholder_cloudinary_key
CLOUDINARY_API_SECRET=placeholder_cloudinary_secret

# Paymob (Local fake adapter / sandbox - Decision #37)
PAYMOB_API_KEY=placeholder_paymob_key
PAYMOB_HMAC_SECRET=placeholder_paymob_hmac_secret
